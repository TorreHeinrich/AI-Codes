  <script>
    // Vorher/Nachher Beispiele Daten
    const examples = [
      {
        beforeWords: "62 Wörter",
        beforeText: "„Bitte lies dir den folgenden sehr komplexen Fachtext genau durch. Ich möchte, dass du zuerst die allerwichtigsten Kernaussagen auf das Wesentliche zusammenfasst, ohne wichtige Fakten wegzulassen. Danach erkläre mir den Inhalt bitte noch einmal so einfach, klar und verständlich, dass ihn selbst ein fünfjähriges Kind ohne Vorwissen sofort begreifen kann. Verzichte dabei komplett auf komplizierte Fremdwörter.“",
        afterWords: "2 Kürzel",
        afterSubject: "[Fachtext einfügen]",
        afterCode: "/tldr /eli5",
        afterDesc: "<strong class='text-accent'>Was passiert:</strong> Die KI kürzt den Text zuerst auf das Wesentliche und erklärt ihn direkt danach in kinderleichter Sprache ohne Fachchinesisch."
      },
      {
        beforeWords: "48 Wörter",
        beforeText: "„Überarbeite meinen folgenden E-Mail-Entwurf so, dass er deutlich professioneller und geschäftsmäßiger klingt, als würde er an einen wichtigen Kunden oder Vorgesetzten gehen. Behalte alle wichtigen Informationen bei, aber streiche unnötige Füllwörter und kürze den gesamten Text um ungefähr zwanzig Prozent, damit er knackig bleibt.“",
        afterWords: "3 Kürzel",
        afterSubject: "[Dein E-Mail-Entwurf]",
        afterCode: "/rewrite /formal /cut20",
        afterDesc: "<strong class='text-accent'>Was passiert:</strong> Der Entwurf wird neu formuliert, wechselt in einen souveränen Business-Ton und wird um rund 20 Prozent gestrafft – bei gleichem Inhalt."
      },
      {
        beforeWords: "54 Wörter",
        beforeText: "„Erstelle eine hochdetaillierte technische Illustration einer modernen Siebträgermaschine. Zerlege die Maschine in alle ihre einzelnen Bauteile, die sauber geordnet in der Luft schweben, und stelle das Ganze im Stil eines klassischen technischen Konstruktionsplans mit feinen weißen Linien auf einem tiefblauen Hintergrund dar.“",
        afterWords: "2 Kürzel",
        afterSubject: "Siebträgermaschine",
        afterCode: "/explodedview /blueprint",
        afterDesc: "<strong class='text-accent'>Was passiert:</strong> Deine Bild-KI zerlegt das Objekt in schwebende Einzelteile und rendert sie als präzisen Bauplan in weißen Linien auf blauem Grund."
      }
    ];

    let currentExampleIndex = 0;

    function switchExample(index) {
      currentExampleIndex = index;
      const ex = examples[index];
      document.getElementById('before-words').textContent = ex.beforeWords;
      document.getElementById('before-text').textContent = ex.beforeText;
      document.getElementById('after-words').textContent = ex.afterWords;
      document.getElementById('after-subject').textContent = ex.afterSubject;
      document.getElementById('after-code').textContent = ex.afterCode;
      document.getElementById('after-desc').innerHTML = ex.afterDesc;

      document.querySelectorAll('.example-tab').forEach((btn, i) => {
        if (i === index) {
          btn.className = "example-tab bg-accent text-navy font-mono text-xs font-bold px-4 py-2.5 rounded-md transition";
        } else {
          btn.className = "example-tab bg-panel border border-line text-ink hover:border-accent/60 font-mono text-xs font-bold px-4 py-2.5 rounded-md transition";
        }
      });
    }

    // Code kopieren (iFrame-sicher via execCommand)
    function copyActiveCode() {
      const codeText = examples[currentExampleIndex].afterCode;
      const tempInput = document.createElement('textarea');
      tempInput.value = codeText;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);

      const btn = document.getElementById('copy-btn');
      btn.textContent = "Kopiert ✓";
      btn.classList.add("text-accent");
      setTimeout(() => {
        btn.textContent = "Kopieren";
        btn.classList.remove("text-accent");
      }, 1800);
    }

    // FAQ Akkordeon
    function toggleFaq(btn) {
      const answer = btn.nextElementSibling;
      const icon = btn.querySelector('span:last-child');
      const isHidden = answer.classList.contains('hidden');
      
      document.querySelectorAll('.faq-answer').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('#faq-container button span:last-child').forEach(ic => ic.textContent = '+');

      if (isHidden) {
        answer.classList.remove('hidden');
        icon.textContent = '−';
      }
    }

    // Gratis Lead-Magnet Formular (Demo-Handler)
    function handleLeadSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('lead-email').value;
      const feedback = document.getElementById('lead-feedback');
      feedback.classList.remove('hidden');
      feedback.innerHTML = `✓ Test-Modus: Der 1-Seiten-Spickzettel wurde für <strong>${email}</strong> vorgemerkt (Newsletter-Tool-Verknüpfung folgt).`;
      document.getElementById('lead-email').value = '';
    }

    // Platzhalter-Hinweis für Digistore24-Checkout
    function handleCheckoutClick(e) {
      e.preventDefault();
      openModal('checkout');
    }

    // Modal Steuerung
    function openModal(type) {
      const modal = document.getElementById('info-modal');
      const content = document.getElementById('modal-content');
      
      if (type === 'impressum') {
        content.innerHTML = `
          <h3 class="font-display font-bold text-xl text-ink">Impressum</h3>
          <p class="font-mono text-xs text-accent">ANGABEN GEMÄSS § 5 DDG</p>
          <p><strong class="text-ink">Anbieter:</strong><br>Torre Ehlers<br>tedigital<br>Hamburgerstraße 214<br>28205 Bremen</p>
          <p><strong class="text-ink">Kontakt:</strong><br>E-Mail: torre@tedigital.de</p>
          <p class="text-xs text-labelgray pt-2 border-t border-line">Vervielfältigung, Weitergabe oder Weiterverkauf der digitalen Produkte, auch auszugsweise, ist ohne schriftliche Genehmigung nicht gestattet.</p>
        `;
      } else if (type === 'datenschutz') {
        content.innerHTML = `
          <h3 class="font-display font-bold text-xl text-ink">Datenschutzerklärung (Platzhalter)</h3>
          <p>Verantwortlicher im Sinne der DSGVO ist Torre Ehlers, Hamburgerstraße 214, 28205 Bremen (torre@tedigital.de).</p>
          <p>Beim Kauf über unseren Zahlungsdienstleister <strong>Digistore24 GmbH</strong> (St.-Godehard-Straße 32, 31139 Hildesheim) gelten ergänzend die Datenschutzbestimmungen von Digistore24.</p>
          <p class="text-xs text-labelgray bg-chip p-3 rounded border border-line">Hinweis: Hier vor Livegang die vollständige DSGVO-Datenschutzerklärung (inkl. Hosting & E-Mail-Provider) einfügen.</p>
        `;
      } else if (type === 'checkout') {
        content.innerHTML = `
          <div class="font-mono text-xs text-accent uppercase tracking-wider">DIGISTORE24 CHECKOUT-PLATZHALTER</div>
          <h3 class="font-display font-bold text-xl text-ink">Weiterleitung zu Digistore24</h3>
          <p>Dieser Button ist aktuell mit dem Platzhalter <code class="bg-chip px-1.5 py-0.5 rounded text-xraycyan">#digistore24-checkout-placeholder</code> verknüpft.</p>
          <p class="text-xs text-labelgray">Sobald dein Produkt auf Digistore24 freigeschaltet ist, ersetzen wir diesen Link durch deine offizielle Digistore24-Bestellformular-URL (inkl. Order-Bump „30 Kombi-Rezepte“ für 7 € und Upsell „Bildcodes Pro“ für 17 €).</p>
        `;
      }
      modal.classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('info-modal').classList.add('hidden');
    }
  </script>
